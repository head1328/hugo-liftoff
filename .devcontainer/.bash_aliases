#!/bin/bash

alias ll='ls -al'

alias h='history'

alias gs='git status'
alias gc='git checkout'
alias gt='git commit'
alias gta='git commit --amend'
alias gf='git fetch'
alias gl='git pull'
alias gp='git push'
alias gpf='git push -f'
alias gcmpl='git checkout main && git pull'
alias gc-='git checkout -'
alias git='LANG=en_US.UTF-8 git'
