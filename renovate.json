{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":enablePreCommit", ":semanticCommits"],
  "branchPrefix": "chore/renovate-",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/devcontainer\\.json$/"],
      "matchStrings": ["\"HUGO_VERSION\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.woodpecker/.+\\.ya?ml$/"],
      "matchStrings": ["RIPSECRETS_VERSION:\\s*(?<currentValue>\\S+)"],
      "depNameTemplate": "sirwart/ripsecrets",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.woodpecker/.+\\.ya?ml$/"],
      "matchStrings": ["HUGO_VERSION:\\s*(?<currentValue>\\S+)"],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["gohugoio/hugo"],
      "groupName": "hugo"
    },
    {
      "matchPackageNames": ["/shellcheck/", "/markdownlint-cli2/i", "/ripsecrets/"],
      "groupName": "linters"
    },
    {
      "matchPackageNames": ["renovate/renovate"],
      "schedule": ["* * * * 1"]
    }
  ]
}
